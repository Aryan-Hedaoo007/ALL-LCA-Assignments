def is_pythagorean_triplet(a, b, c):
    if a>=b and a>=c:
        hypo = a
        side1 = b
        side2 = c
    elif b>=a and b>=c:
        hypo = b
        side1 = a
        side2 = c
    else:
        hypo = c
        side1 = a
        side2 = b
    if hypo**2 == side1**2 + side2**2:
        return True
    else:
        return False
n1 = int(input("Enter the first side: "))
n2 = int(input("Enter the second side: "))
n3 = int(input("Enter the third side: "))
if is_pythagorean_triplet(n1, n2, n3):
    print("Triangle is right-angled.")
else:
    print("Triangle is not right-angled.")
