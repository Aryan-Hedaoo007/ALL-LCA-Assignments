def is_pythagorean_triplet(a, b, c):
    if a**2 == b**2 + c**2:
        return True
    else:
        return False
n1 = int(input("Enter the hypotenuse: "))
n2 = int(input("Enter the first side: "))
n3 = int(input("Enter the second side: "))
if is_pythagorean_triplet(n1, n2, n3):
    print("The numbers form a Pythagorean triplet.")
else:
    print("The numbers do not form a Pythagorean triplet.")
